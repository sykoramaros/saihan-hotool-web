{
  "name": "saihan-hotool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/frontend && bun run dev",
    "dev:cms": "cd apps/cms && bun run dev",
    "build": "cd apps/frontend && bun run build",
    "preview": "cd apps/frontend && bun run preview",
    "deploy:frontend": "bun run build && rsync -avz --delete apps/frontend/dist/ mac-mini-server:/var/docker/saihan_hotool/apps/frontend/dist/"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
